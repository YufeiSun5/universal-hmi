// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Universal HMI

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = org.universalhmi.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Universal HMI contributors. All rights reserved.

// Stable launcher name; Finder displays the product name.
EXECUTABLE_NAME = universal_hmi

// Direct-distribution development build: no signing identities or provisioning.
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY =

// Both Apple silicon and Intel; never silently ship only the build host arch.
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

// Go 1.24 requires macOS 11 or later.
MACOSX_DEPLOYMENT_TARGET = 11.0
